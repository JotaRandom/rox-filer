# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files with LF line endings
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.cc text eol=lf
*.hh text eol=lf
*.cxx text eol=lf
*.hxx text eol=lf

# Shell scripts should use LF
*.sh text eol=lf

# Configuration files
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Source files
*.py text eol=lf
*.rb text eol=lf
*.java text eol=lf
*.cs text eol=lf

# Documentation
*.rst text eol=lf
*.tex text eol=lf

# Git related files
.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf

# Keep Windows batch files with CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files should not be modified
*.bin binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.o binary
*.obj binary
*.d binary
*.pdb binary
*.idb binary
*.class binary
*.jar binary
*.war binary
*.ear binary
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.svg binary
*.otf binary
